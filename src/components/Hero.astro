---
const { profile, stats } = Astro.props;
---

<section id="top" class="grid gap-6 lg:grid-cols-[1.35fr_minmax(320px,0.9fr)] lg:gap-8">
  <div class="panel relative overflow-hidden px-6 py-8 sm:px-8 sm:py-10">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--accent)] to-transparent opacity-60"></div>
    <div class="space-y-7">
      <div class="space-y-4">
        <p class="section-kicker">{profile.name}</p>
        <h1 class="hero-title">{profile.headline}</h1>
        <p class="hero-copy max-w-2xl">{profile.summary}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="cta-primary" href="#projects">View selected work</a>
        <a class="cta-secondary" href={`mailto:${profile.email}`}>Email me</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          profile.socialLinks.map((link) => (
            <a class="social-chip" href={link.href} rel="noreferrer" target="_blank">
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="grid gap-4 pt-4 sm:grid-cols-3">
        {
          stats.map((item) => (
            <div class="metric-card">
              <span class="metric-value">{item.value}</span>
              <p class="metric-label">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <aside class="panel px-6 py-8 sm:px-8 sm:py-10">
    <div class="space-y-6">
      <div class="space-y-3">
        <p class="section-kicker">Current focus</p>
        <p class="text-2xl leading-tight font-semibold text-[var(--ink)]">
          {profile.currentFocus}
        </p>
      </div>
      <div class="grid gap-4">
        <div class="soft-panel">
          <span class="detail-label">Location</span>
          <p class="detail-copy">{profile.location}</p>
        </div>
        <div class="soft-panel">
          <span class="detail-label">Availability</span>
          <p class="detail-copy">{profile.availability}</p>
        </div>
      </div>
      <div class="grid gap-3">
        <span class="detail-label">Ideal engagements</span>
        <div class="flex flex-wrap gap-2">
          {
            profile.engagementTypes.map((item) => (
              <span class="inline-flex rounded-full border border-black/10 bg-white px-3 py-1 text-sm font-medium text-[var(--ink)]">
                {item}
              </span>
            ))
          }
        </div>
      </div>
      <div class="grid gap-3">
        <span class="detail-label">How I work</span>
        <ul class="grid gap-3 text-sm leading-6 text-[var(--muted)]">
          {
            profile.workingStyle.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-2 w-2 rounded-full bg-[var(--accent)]"></span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </aside>
</section>
