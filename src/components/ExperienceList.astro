---
const { items } = Astro.props;
---

<div class="grid gap-4">
  {
    items.map((item) => (
      <article class="panel px-6 py-6 sm:px-8">
        <div class="grid gap-5 lg:grid-cols-[220px_1fr] lg:gap-8">
          <div class="space-y-2">
            <p class="text-sm font-semibold tracking-[0.18em] text-[var(--accent-strong)] uppercase">
              {item.period}
            </p>
            <div>
              <h3 class="text-xl font-semibold text-[var(--ink)]">{item.role}</h3>
              <p class="text-sm text-[var(--muted)]">{item.company}</p>
            </div>
          </div>
          <div class="space-y-4">
            <p class="text-base leading-7 text-[var(--muted)]">{item.summary}</p>
            <ul class="grid gap-3">
              {
                item.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm leading-6 text-[var(--muted)]">
                    <span class="mt-2 h-2 w-2 rounded-full bg-[var(--secondary)]"></span>
                    <span>{highlight}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </article>
    ))
  }
</div>
